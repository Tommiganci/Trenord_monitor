{
  "version": 2,
  "builds": [
    {
      "src": "api/train_live.js",
      "use": "@vercel/node"
    },
    {
      "src": "docs/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/train_live/(.*)",
      "dest": "/api/train_live.js?numero=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/docs/$1"
    }
  ]
}
